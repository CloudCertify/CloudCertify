  "components": {
    "schemas": {
      "AnswerDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "text": {
            "type": "string",
            "nullable": true
          },
          "image": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "AnswerQuestionRequestDto": {
        "type": "object",
        "properties": {
          "submissionId": {
            "type": "integer",
            "format": "int32"
          },
          "questionId": {
            "type": "integer",
            "format": "int32"
          },
          "answerIds": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32"
            }
          },
          "confidence": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Confidence"
              }
            ],
            "nullable": true
          }
        }
      },
      "Confidence": {
        "enum": ["guess", "unsure", "confident"],
        "type": "string"
      },
      "CheckAnswerRequestDto": {
        "type": "object",
        "properties": {
          "submissionId": {
            "type": "integer",
            "format": "int32"
          },
          "questionId": {
            "type": "integer",
            "format": "int32"
          },
          "answerIds": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32"
            }
          }
        }
      },
      "CheckAnswerResponseDto": {
        "required": [
          "isCorrect",
          "correctAnswerIds",
          "selectedAnswerIds"
        ],
        "type": "object",
        "properties": {
          "isCorrect": {
            "type": "boolean"
          },
          "correctAnswerIds": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32"
            }
          },
          "selectedAnswerIds": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32"
            }
          },
          "explanation": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "CreateReportRequestDto": {
        "type": "object",
        "properties": {
          "submissionId": {
            "type": "integer",
            "format": "int32"
          },
          "questionId": {
            "type": "integer",
            "format": "int32"
          },
          "reasons": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReportReason"
            }
          },
          "comment": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "DomainResult": {
        "required": [
          "domain",
          "correct",
          "total",
          "weight"
        ],
        "type": "object",
        "properties": {
          "domain": {
            "type": "string"
          },
          "correct": {
            "type": "integer",
            "format": "int32"
          },
          "total": {
            "type": "integer",
            "format": "int32"
          },
          "weight": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "FinishSubquizRequestDto": {
        "type": "object",
        "properties": {
          "submissionId": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "Language": {
        "enum": [
          "en_us",
          "pt_br"
        ],
        "type": "string"
      },
      "MeDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "email": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "avatarUrl": {
            "type": "string",
            "nullable": true
          },
          "providers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProviderKind"
            }
          }
        }
      },
      "MySubmissionDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "quizId": {
            "type": "integer",
            "format": "int32"
          },
          "subquizId": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "finished": {
            "type": "boolean"
          },
          "score": {
            "type": "integer",
            "format": "int32"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ProviderKind": {
        "enum": [
          "google",
          "git_hub"
        ],
        "type": "string"
      },
      "QuestionDifficulty": {
        "enum": [
          "easy",
          "medium",
          "hard"
        ],
        "type": "string"
      },
      "QuestionDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "text": {
            "type": "string",
            "nullable": true
          },
          "images": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "type": {
            "$ref": "#/components/schemas/QuestionType"
          },
          "selectCount": {
            "type": "integer",
            "format": "int32"
          },
          "difficulty": {
            "$ref": "#/components/schemas/QuestionDifficulty"
          },
          "answers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AnswerDto"
            }
          }
        }
      },
      "QuestionType": {
        "enum": [
          "multiple_choice",
          "multiple_response"
        ],
        "type": "string"
      },
      "QuizAnswer": {
        "type": "object",
        "properties": {
          "questionId": {
            "type": "integer",
            "format": "int32"
          },
          "answerIds": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32"
            }
          }
        }
      },
      "QuizDetailDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "submissionId": {
            "type": "integer",
            "format": "int32"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "questions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QuestionDto"
            }
          }
        }
      },
      "QuizDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "iconName": {
            "type": "string"
          },
          "isAvailable": {
            "type": "boolean"
          },
          "quizProvider": {
            "$ref": "#/components/schemas/QuizProvider"
          },
          "quizLevel": {
            "$ref": "#/components/schemas/QuizLevel"
          },
          "slug": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "questionCount": {
            "type": "integer",
            "format": "int32"
          },
          "minQuestions": {
            "type": "integer",
            "format": "int32"
          },
          "maxQuestions": {
            "type": "integer",
            "format": "int32"
          },
          "subQuizzes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SubquizDto"
            },
            "nullable": true
          }
        }
      },
      "QuizLevel": {
        "enum": [
          "foundational",
          "associate",
          "professional",
          "specialist"
        ],
        "type": "string"
      },
      "QuizProvider": {
        "enum": [
          "azure",
          "aws",
          "gcp"
        ],
        "type": "string"
      },
